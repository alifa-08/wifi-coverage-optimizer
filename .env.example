# ==============================================================================
# CAMPUS WI-FI OPTIMIZATION & GATEWAY AUTHENTICATION - ENVIRONMENT TEMPLATE
# ==============================================================================
# This template contains safe placeholder variables for configuring the backend.
# Copy this file to '.env' and populate with your local values as needed.
# NEVER commit production passwords, tokens, or private secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Database URL (Defaults to SQLite in data/wifi_optimizer.db)
DATABASE_URL=sqlite:///data/wifi_optimizer.db

# ==============================================================================
# SMTP Email Delivery Configuration for Secure Password Reset
# ==============================================================================
# Set SMTP_ENABLED=true once valid SMTP provider credentials are provided.
# When SMTP_ENABLED=false, the system safely disables outbound emails without
# crashing, and informs users that email delivery is currently unconfigured.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=campus_wifi_noreply@example.com
SMTP_PASSWORD=your_secure_smtp_app_password
SMTP_FROM_EMAIL=wifi-portal@campus.edu.in
SMTP_FROM_NAME=Campus Wi-Fi Portal
SMTP_USE_TLS=true

# Security & Expiration Policies
PASSWORD_RESET_EXPIRE_MINUTES=15
ALLOW_DEV_RESET_MAILBOX=true

# OpenWrt Gateway & OpenNDS FAS Configuration (Private to Backend)
OPENWRT_HOST=192.168.214.2
OPENWRT_USER=root
OPENWRT_SSH_KEY_PATH=C:\Users\username\.ssh\id_ed25519
OPENWRT_TIMEOUT_SEC=5
OPENNDS_FAS_KEY=your_opennds_fas_secret_key_here
OPENNDS_MHD_PORT=2050
